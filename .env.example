# DB CONFIGS
# `make up-app` (API Docker'da) bo'lganda DB_HOST, REDIS_HOST va ichki
# portlarni docker-compose.yml o'zi qo'yadi; bu yerdagi DB_PORT, REDIS_PORT
# va HTTP_PORT — host'ga (127.0.0.1) chiqariladigan portlar.
# DB_PASSWORD'da URL belgilari (@ : / ? #) bo'lmasin: migrate DSN'ni buzadi.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=


# JWT Configs
JWT_SECRET=
ACCESS_TTL=
REFRESH_TTL=
OTP_TTL=

# Redis Configs
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# HTTP Configs
HTTP_PORT=

# Vergul bilan ajratilgan ro'yxat. Bo'sh bo'lsa CORS yoqilmaydi va
# brauzerdagi mijozlar bloklanadi. Wildcard "*" qo'llab-quvvatlanmaydi.
# Masalan: https://dehqonbobo.uz,https://www.dehqonbobo.uz
CORS_ALLOWED_ORIGINS=

# Ilova ishonchli reverse proxy (nginx, ALB) ORTIDA turgandagina "true".
# Faqat shunda X-Forwarded-For / X-Real-IP ga ishoniladi. To'g'ridan-to'g'ri
# internetga chiqqan ilovada bu sarlavhalarni har kim yozadi — soxta bo'ladi.
TRUST_PROXY=false

# Bitta IP dan daqiqasiga nechta so'rov. 0 = cheklov o'chiq.
# Modul darajasidagi identifier cheklovlaridan alohida qatlam.
RATE_LIMIT_PER_MINUTE=120

# SMTP Configs
# Bo'sh qoldirilsa OTP faqat log'ga yoziladi (dev rejimi).
# Gmail uchun: HOST=smtp.gmail.com, USERNAME=to'liq email manzil,
# PASSWORD=app password (oddiy parol emas, 2FA yoqilgan bo'lishi kerak).
# FROM autentifikatsiya qilingan manzil bo'lishi shart; ko'rinadigan
# nom esa FROM_NAME orqali beriladi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# OTP xati so'rov ichida sinxron yuboriladi, shuning uchun bu qiymat
# server WriteTimeout'idan (30s) kichik bo'lishi kerak. Default 15s.
NOTIFIER_TIMEOUT=

# Telegram Configs
# Token @BotFather dan olinadi. Bo'sh bo'lsa bot ishga tushmaydi va
# Telegram OTP'lari faqat log'ga yoziladi.
TELEGRAM_BOT_TOKEN=

# Telegram Mini App manzili (faqat https://). Bot /start da va chat
# menyusida shu ilovani ochadigan tugma qo'yadi; http yoki bo'sh bo'lsa bot
# eski rejimda ishlaydi (/login kodi). Lokal sinov: cloudflared tunnel.
# Brauzer uchun kod-login havolasi ham shu manzilda: <WEB_APP_URL>/login?code=<kod>
WEB_APP_URL=

# Long polling so'rovi Telegram tomonda qancha ushlab turiladi.
# HTTP mijoz timeout'i (90s) bundan katta bo'lishi shart.
TELEGRAM_POLL_TIMEOUT=30s

# Mini App (Telegram.WebApp.initData) qancha vaqt amal qiladi — auth_date dan.
# Ilova ochilganda initData yangilanadi; uzoq ochiq turgan oynada qayta
# kirish uchun bir necha soat yetarli.
TELEGRAM_WEBAPP_MAX_AGE=24h



# ---- Mini App (web konteyneri: Caddy) ----
# Domen bo'lsa Caddy HTTPS sertifikatini o'zi oladi (WEB_BIND=0.0.0.0,
# WEB_PORT=80, WEB_TLS_PORT=443). Lokal: bo'sh — http://127.0.0.1:WEB_PORT.
SITE_ADDRESS=
WEB_BIND=127.0.0.1
WEB_PORT=8090
WEB_TLS_PORT=8443
